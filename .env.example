# --- Core ---
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
# Public URL of the web app (used in links, CLI login and Discussion posts)
HUB_URL=http://localhost:3000
HUB_ORG_NAME="Acme Engineering"
HUB_ORG_SLUG=acme

# --- Auth (NextAuth, backed by the GitHub App's OAuth credentials) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Local development only: shows a "sign in as <login>" form instead of GitHub OAuth.
HUB_DEV_LOGIN=false

# --- GitHub App (Discussions + webhooks) ---
GITHUB_APP_ID=
# PEM contents; literal "\n" sequences are converted to newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Agents / kagent ---
# "kagent" dispatches requests to liaison agents; "off" sends every request straight to humans.
HUB_AGENT_MODE=off
KAGENT_URL=http://kagent-controller.kagent:8083
KAGENT_NAMESPACE=kagent
KAGENT_API_KEY_SECRET=kagent-anthropic
KAGENT_API_KEY_SECRET_KEY=ANTHROPIC_API_KEY
KAGENT_DEFAULT_MODEL=claude-sonnet-4-5
KAGENT_INVOKE_TIMEOUT_SECONDS=300
# When true the worker applies rendered manifests to the cluster (in-cluster or ~/.kube/config).
HUB_KUBE_APPLY=false

# --- Worker ---
WORKER_PORT=4000
# Requests not answered within this window are escalated to humans.
HUB_REQUEST_TIMEOUT_MINUTES=30

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=
SMTP_URL=
SMTP_FROM="Agent Liaison Hub <hub@example.com>"
